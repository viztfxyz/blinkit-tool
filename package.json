{
  "name": "handcart",
  "version": "0.2.0",
  "description": "Unofficial multi-platform quick-commerce client (Blinkit + Zepto): search and compare, cart, checkout and UPI pay, as a CLI, library and MCP server",
  "keywords": [
    "handcart",
    "blinkit",
    "zepto",
    "grocery",
    "quick-commerce",
    "india",
    "upi",
    "cli",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent"
  ],
  "homepage": "https://github.com/viztfxyz/blinkit-tool#readme",
  "bugs": {
    "url": "https://github.com/viztfxyz/blinkit-tool/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/viztfxyz/blinkit-tool.git"
  },
  "license": "MIT",
  "author": "Viz",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "handcart": "dist/bin/handcart.js",
    "handcart-mcp": "dist/bin/handcart-mcp.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/bin/handcart.ts",
    "mcp": "tsx src/bin/handcart-mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:match": "node scripts/bench-match.mjs",
    "prepare": "npm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "cuimp": "^2.1.2",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
